model user_sessions {
  session_id BigInt   @id @default(autoincrement())
  user_id    BigInt
  token_hash String   @unique @db.VarChar(64)
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model audit_logs {
  audit_id    BigInt   @id @default(autoincrement())
  user_id     BigInt?
  action      String   @db.VarChar(50)
  table_name  String?  @db.VarChar(150)
  record_id   String?  @db.VarChar(100)
  old_value   Json?
  new_value   Json?
  description String?
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users?   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_user")

  @@index([created_at], map: "idx_audit_created_at")
  @@index([table_name, record_id], map: "idx_audit_table_record")
  @@index([user_id], map: "idx_audit_user")
}

model bill_adjustments {
  adjustment_id                             BigInt    @id @default(autoincrement())
  bill_id                                   BigInt
  adjustment_type                           String    @db.VarChar(50)
  amount                                    Decimal   @default(0) @db.Decimal(14, 2)
  reason                                    String?
  approved_by                               BigInt?
  approved_at                               DateTime? @db.Timestamp(6)
  created_by                                BigInt?
  created_at                                DateTime  @default(now()) @db.Timestamp(6)
  users_bill_adjustments_approved_byTousers users?    @relation("bill_adjustments_approved_byTousers", fields: [approved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bill_adjustment_approved_by")
  bills                                     bills     @relation(fields: [bill_id], references: [bill_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bill_adjustment_bill")
  users_bill_adjustments_created_byTousers  users?    @relation("bill_adjustments_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bill_adjustment_created_by")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bill_details {
  bill_detail_id BigInt          @id @default(autoincrement())
  bill_id        BigInt
  charge_type    String          @db.VarChar(50)
  rate_id        BigInt?
  description    String?
  quantity       Decimal         @default(0) @db.Decimal(14, 3)
  rate           Decimal         @default(0) @db.Decimal(14, 4)
  amount         Decimal         @default(0) @db.Decimal(14, 2)
  sequence_no    Int?
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  bills          bills           @relation(fields: [bill_id], references: [bill_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bill_detail_bill")
  mt_water_rates mt_water_rates? @relation(fields: [rate_id], references: [rate_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bill_detail_rate")
}

model bill_penalties {
  bill_penalty_id  BigInt           @id @default(autoincrement())
  bill_id          BigInt
  penalty_id       BigInt
  base_amount      Decimal          @default(0) @db.Decimal(14, 2)
  rate             Decimal          @default(0) @db.Decimal(10, 4)
  amount           Decimal          @default(0) @db.Decimal(14, 2)
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  bills            bills            @relation(fields: [bill_id], references: [bill_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bill_penalty_bill")
  mt_penalty_rates mt_penalty_rates @relation(fields: [penalty_id], references: [penalty_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bill_penalty_rate")
}

