generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model customers {
  customer_id Int      @id
  account_no  String   @db.VarChar(10)
  first_name  String   @db.VarChar
  last_name   String   @db.VarChar
  address     String
  created_at  DateTime @db.Timestamp(6)
}

model water_consumers {
  consumer_id   Int      @id @default(autoincrement())
  account_no    String   @db.VarChar(20)
  first_name    String   @db.VarChar(50)
  last_name     String   @db.VarChar(50)
  address       String?
  meter_no      String?  @db.VarChar(30)
  meter_reading Decimal? @default(0) @db.Decimal(12, 2)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
}

model roles {
  role_id     BigInt       @id @default(autoincrement())
  role_name   String       @unique @db.VarChar(50)
  description String?      @db.VarChar(255)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  user_roles  user_roles[]
}

model user_roles {
  user_id     BigInt
  role_id     BigInt
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  roles       roles    @relation(fields: [role_id], references: [role_id], onUpdate: NoAction, map: "fk_user_roles_role")
  users       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@id([user_id, role_id])
}

model users {
  user_id       BigInt       @id @default(autoincrement())
  username      String       @unique @db.VarChar(50)
  password_hash String
  first_name    String       @db.VarChar(50)
  middle_name   String?      @db.VarChar(50)
  last_name     String       @db.VarChar(50)
  email         String?      @db.VarChar(150)
  is_active     Boolean      @default(true)
  last_login_at DateTime?    @db.Timestamp(6)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)
  user_roles    user_roles[]
}
